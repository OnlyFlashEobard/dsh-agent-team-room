{
  "name": "@local/agent-team-room",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "OnlyFlashEobard",
  "description": "A multi-agent collaboration studio for DeepSeek Harness: configure agent roles and models, assign a mission, and watch the agents converse and summarize.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OnlyFlashEobard/dsh-agent-team-room.git"
  },
  "homepage": "https://github.com/OnlyFlashEobard/dsh-agent-team-room",
  "bugs": {
    "url": "https://github.com/OnlyFlashEobard/dsh-agent-team-room/issues"
  },
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
